\newlabel{eq:interp_loss_drive}{{10}{17}{}{equation.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Encoding the Road Environment}{17}{}\protected@file@percent }
\newlabel{sec:encoding}{{5.2}{17}{}{subsection.5.2}{}}
\@writefile{toc}{\contentsline {paragraph}{Challenge and motivation}{17}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Temporal road-context encoder}{17}{}\protected@file@percent }
\newlabel{eq:temporal_encoder}{{11}{17}{}{equation.11}{}}
\citation{chen2020learning}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Encoding the road environment. The road-context state $z^{r}=(e_{\mathrm  {CTE}}, e_\psi , \kappa )$ is defined geometrically with respect to the lane center: the cross-track error is the signed lateral offset, the heading error is the angle between the vehicle heading and the road tangent, and $\kappa $ is the local curvature. For a forward-facing camera the road is visible only over a short preview (shaded), so the physical encoder $\mathcal  {E}_p$ aggregates a temporal window of images into a curvature \emph  {profile} $\hat  {\kappa }(s+\Delta )$ sampled at ten offsets over the first \SI {4.5}{m} ahead. On the real DonkeyCar this encoding is supervised by privileged track localization at training time and recovered from the front camera alone at test time.}}{18}{}\protected@file@percent }
\newlabel{fig:encoding}{{3}{18}{}{figure.3}{}}
