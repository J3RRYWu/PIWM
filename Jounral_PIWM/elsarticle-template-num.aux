\newlabel{eq:augmented_dyn}{{2}{11}{}{equation.2}{}}
\newlabel{def:partial_obs}{{4}{11}{}{definition.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Partial observability in driving. Two vehicles with identical kinematic states $(x, y, \psi , v)$, issued identical actions, follow divergent futures because the road geometry ahead differs. The vehicle state alone is therefore non-Markov: the road context $r_t$ (lane shape and the vehicle's relation to it) is missing from it and, for a forward-facing camera, the road is visible only over a short preview (shaded wedge), so $r_t$ must be both encoded from images and predicted forward.}}{12}{}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:partial_obs}{{1}{12}{}{figure.1}{}}
